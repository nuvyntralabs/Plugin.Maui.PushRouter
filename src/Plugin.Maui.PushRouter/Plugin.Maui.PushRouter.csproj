<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

		<RootNamespace>Plugin.Maui.PushRouter</RootNamespace>
		<AssemblyName>Plugin.Maui.PushRouter</AssemblyName>
		<PackageId>Plugin.Maui.PushRouter</PackageId>
		<Title>.NET MAUI PushRouter — FCM and APNs to Shell</Title>
		<Description>Route FCM and APNs push notifications to handlers and MAUI screens on Android and iOS. Parse payloads, dispatch by route/type, and navigate Shell pages from notification taps.</Description>
		<PackageTags>dotnet-maui;maui;maui-plugin;maui-utilities;cross-platform;android;ios;nuget;mauiessentials;push;notifications;fcm;apns;firebase;routing;deeplink;shell</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageProjectUrl>https://nuvyntralabs.github.io/packages/plugin-maui-push-router/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/nuvyntralabs/Plugin.Maui.PushRouter</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Authors>MauiEssentials</Authors>
		<Company>MauiEssentials</Company>
		<Copyright>Copyright © MauiEssentials</Copyright>
		<Version>1.0.6</Version>
		<PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
		<IsPackable>true</IsPackable>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PackageReleaseNotes>Navigate only through registered maps or DefaultRoute unless AllowUnmappedPayloadRoutes is true.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\..\nuget.png" Pack="true" PackagePath="icon.png" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.PushRouter.Tests" />
	</ItemGroup>

</Project>
